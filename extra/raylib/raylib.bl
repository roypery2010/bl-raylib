KEY_SIX :: 54;
KEY_SEVEN :: 55;
KEY_EIGHT :: 56;
KEY_NINE :: 57;
KEY_SEMICOLON :: 59;
KEY_EQUAL :: 61;
KEY_A :: 65;
KEY_B :: 66;
