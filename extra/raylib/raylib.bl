KEY_F :: 70;
KEY_G :: 71;
KEY_H :: 72;
KEY_I :: 73;
KEY_J :: 74;
KEY_K :: 75;
KEY_L :: 76;
KEY_M :: 77;
KEY_N :: 78;
KEY_O :: 79;
KEY_P :: 80;
KEY_Q :: 81;
KEY_R :: 82;
KEY_S :: 83;
KEY_T :: 84;
KEY_U :: 85;
KEY_V :: 86;
KEY_W :: 87;
KEY_X :: 88;
KEY_Y :: 89;
KEY_Z :: 90;
KEY_LEFT_BRACKET :: 91;
KEY_BACKSLASH :: 92;
KEY_RIGHT_BRACKET :: 93;
KEY_GRAVE :: 96;
KEY_SPACE :: 32;
KEY_ESCAPE :: 256;
KEY_ENTER :: 257;
KEY_TAB :: 258;
KEY_BACKSPACE :: 259;
KEY_INSERT :: 260;
KEY_DELETE :: 261;
KEY_RIGHT :: 262;
KEY_LEFT :: 263;
KEY_DOWN :: 264;
KEY_UP :: 265;
KEY_PAGE_UP :: 266;
KEY_PAGE_DOWN :: 267;
KEY_HOME :: 268;
KEY_END :: 269;
KEY_CAPS_LOCK :: 280;
KEY_SCROLL_LOCK :: 281;
KEY_NUM_LOCK :: 282;
KEY_PRINT_SCREEN :: 283;
KEY_PAUSE :: 284;
KEY_F1 :: 290;
KEY_F2 :: 291;
KEY_F3 :: 292;
KEY_F4 :: 293;
KEY_F5 :: 294;
KEY_F6 :: 295;
KEY_F7 :: 296;
KEY_F8 :: 297;
KEY_F9 :: 298;
KEY_F10 :: 299;
KEY_F11 :: 300;
KEY_F12 :: 301;
KEY_LEFT_SHIFT :: 340;
KEY_LEFT_CONTROL :: 341;
KEY_LEFT_ALT :: 342;
KEY_LEFT_SUPER :: 343;
KEY_RIGHT_SHIFT :: 344;
KEY_RIGHT_CONTROL :: 345;
KEY_RIGHT_ALT :: 346;
KEY_RIGHT_SUPER :: 347;

// Mouse buttons.
MOUSE_BUTTON_LEFT :: 0;
MOUSE_BUTTON_RIGHT :: 1;
MOUSE_BUTTON_MIDDLE :: 2;
MOUSE_BUTTON_SIDE :: 3;
MOUSE_BUTTON_EXTRA :: 4;
MOUSE_BUTTON_FORWARD :: 5;
MOUSE_BUTTON_BACK :: 6;

// Gamepad buttons (raylib's standard mapping).
GAMEPAD_BUTTON_UNKNOWN :: 0;
GAMEPAD_BUTTON_LEFT_FACE_UP :: 1;
GAMEPAD_BUTTON_LEFT_FACE_RIGHT :: 2;
GAMEPAD_BUTTON_LEFT_FACE_DOWN :: 3;
GAMEPAD_BUTTON_LEFT_FACE_LEFT :: 4;
GAMEPAD_BUTTON_RIGHT_FACE_UP :: 5;
GAMEPAD_BUTTON_RIGHT_FACE_RIGHT :: 6;
GAMEPAD_BUTTON_RIGHT_FACE_DOWN :: 7;
GAMEPAD_BUTTON_RIGHT_FACE_LEFT :: 8;
GAMEPAD_BUTTON_LEFT_TRIGGER_1 :: 9;
GAMEPAD_BUTTON_LEFT_TRIGGER_2 :: 10;
GAMEPAD_BUTTON_RIGHT_TRIGGER_1 :: 11;
GAMEPAD_BUTTON_RIGHT_TRIGGER_2 :: 12;
GAMEPAD_BUTTON_MIDDLE_LEFT :: 13;
GAMEPAD_BUTTON_MIDDLE :: 14;
GAMEPAD_BUTTON_MIDDLE_RIGHT :: 15;
GAMEPAD_BUTTON_LEFT_THUMB :: 16;
GAMEPAD_BUTTON_RIGHT_THUMB :: 17;

// Colors are passed by value using the C-compatible four-byte layout.
Color :: struct {
r: u8;
g: u8;
b: u8;
a: u8;
};

RAYWHITE :: Color.{ 245, 245, 245, 255 };
WHITE :: Color.{ 255, 255, 255, 255 };
BLACK :: Color.{ 0, 0, 0, 255 };
RED :: Color.{ 230, 41, 55, 255 };
GREEN :: Color.{ 0, 228, 48, 255 };
BLUE :: Color.{ 0, 121, 241, 255 };
YELLOW :: Color.{ 253, 249, 0, 255 };
ORANGE :: Color.{ 255, 161, 0, 255 };
PURPLE :: Color.{ 200, 122, 255, 255 };
DARKGRAY :: Color.{ 80, 80, 80, 255 };
GRAY :: Color.{ 130, 130, 130, 255 };
LIGHTGRAY :: Color.{ 200, 200, 200, 255 };

Vector2 :: struct {
x: f32;
y: f32;
};

Rectangle :: struct {
x: f32;
y: f32;
width: f32;
height: f32;
};

// Audio data and stream types. The raw pointers mirror raylib's void* and
// internal opaque audio pointers while preserving the C ABI layout.
Wave :: struct {
frameCount: u32;
sampleRate: u32;
sampleSize: u32;
channels: u32;
data: *u8;
};

AudioStream :: struct {
buffer: *u8;
processor: *u8;
sampleRate: u32;
sampleSize: u32;
channels: u32;
};

Sound :: struct {
stream: AudioStream;
frameCount: u32;
};

Music :: struct {
stream: AudioStream;
frameCount: u32;
looping: bool;
ctxType: s32;
ctxData: *u8;
};

// AudioCallback receives a writable audio buffer and the number of frames.
AudioCallback :: *fn (bufferData: *u8, frames: u32);

InitWindow :: fn (width: s32, height: s32, title: *s8) #extern;
CloseWindow :: fn () #extern;
WindowShouldClose :: fn () bool #extern;
IsWindowReady :: fn () bool #extern;
IsWindowFullscreen :: fn () bool #extern;
ToggleFullscreen :: fn () #extern;
SetWindowTitle :: fn (title: *s8) #extern;
GetScreenWidth :: fn () s32 #extern;
GetScreenHeight :: fn () s32 #extern;
SetWindowPosition :: fn (x: s32, y: s32) #extern;
SetWindowMinSize :: fn (width: s32, height: s32) #extern;
SetWindowSize :: fn (width: s32, height: s32) #extern;
SetConfigFlags :: fn (flags: s32) #extern;
SetTargetFPS :: fn (fps: s32) #extern;
GetFPS :: fn () s32 #extern;
GetFrameTime :: fn () f32 #extern;
GetTime :: fn () f64 #extern;
GetColor :: fn (hexValue: u32) Color #extern;

BeginDrawing :: fn () #extern;
EndDrawing :: fn () #extern;
ClearBackground :: fn (color: Color) #extern;

DrawPixel :: fn (posX: s32, posY: s32, color: Color) #extern;
DrawLine :: fn (startPosX: s32, startPosY: s32, endPosX: s32, endPosY: s32, color: Color) #extern;
DrawCircle :: fn (centerX: s32, centerY: s32, radius: f32, color: Color) #extern;
DrawCircleLines :: fn (centerX: s32, centerY: s32, radius: f32, color: Color) #extern;
DrawRectangle :: fn (posX: s32, posY: s32, width: s32, height: s32, color: Color) #extern;
DrawRectangleLines :: fn (posX: s32, posY: s32, width: s32, height: s32, color: Color) #extern;
DrawRectangleRec :: fn (rec: Rectangle, color: Color) #extern;
DrawRectangleLinesEx :: fn (rec: Rectangle, lineThick: f32, color: Color) #extern;
DrawTriangle :: fn (v1: Vector2, v2: Vector2, v3: Vector2, color: Color) #extern;
DrawText :: fn (text: *s8, posX: s32, posY: s32, fontSize: s32, color: Color) #extern;
MeasureText :: fn (text: *s8, fontSize: s32) s32 #extern;

IsKeyPressed :: fn (key: s32) bool #extern;
IsKeyDown :: fn (key: s32) bool #extern;
IsKeyReleased :: fn (key: s32) bool #extern;
IsKeyUp :: fn (key: s32) bool #extern;
GetKeyPressed :: fn () s32 #extern;
IsMouseButtonPressed :: fn (button: s32) bool #extern;
IsMouseButtonDown :: fn (button: s32) bool #extern;
IsMouseButtonReleased :: fn (button: s32) bool #extern;
GetMouseX :: fn () s32 #extern;
GetMouseY :: fn () s32 #extern;
GetMousePosition :: fn () Vector2 #extern;
GetMouseWheelMove :: fn () f32 #extern;

SetExitKey :: fn (key: s32) #extern;
WaitTime :: fn (seconds: f64) #extern;
SetTraceLogLevel :: fn (logLevel: s32) #extern;

// Audio device management.
InitAudioDevice :: fn () #extern;
CloseAudioDevice :: fn () #extern;
IsAudioDeviceReady :: fn () bool #extern;
SetMasterVolume :: fn (volume: f32) #extern;
GetMasterVolume :: fn () f32 #extern;

// Wave loading, conversion, export, and sample access.
LoadWave :: fn (fileName: *s8) Wave #extern;
LoadWaveFromMemory :: fn (fileType: *s8, fileData: *u8, dataSize: s32) Wave #extern;
IsWaveValid :: fn (wave: Wave) bool #extern;
UnloadWave :: fn (wave: Wave) #extern;
ExportWave :: fn (wave: Wave, fileName: *s8) bool #extern;
ExportWaveAsCode :: fn (wave: Wave, fileName: *s8) bool #extern;
WaveCopy :: fn (wave: Wave) Wave #extern;
WaveCrop :: fn (wave: *Wave, initFrame: s32, finalFrame: s32) #extern;
WaveFormat :: fn (wave: *Wave, sampleRate: s32, sampleSize: s32, channels: s32) #extern;
LoadWaveSamples :: fn (wave: Wave) *f32 #extern;
UnloadWaveSamples :: fn (samples: *f32) #extern;

// Sound loading, playback, aliases, and controls.
LoadSound :: fn (fileName: *s8) Sound #extern;
LoadSoundFromWave :: fn (wave: Wave) Sound #extern;
LoadSoundAlias :: fn (source: Sound) Sound #extern;
IsSoundValid :: fn (sound: Sound) bool #extern;
UpdateSound :: fn (sound: Sound, data: *u8, frameCount: s32) #extern;
UnloadSound :: fn (sound: Sound) #extern;
UnloadSoundAlias :: fn (alias: Sound) #extern;
PlaySound :: fn (sound: Sound) #extern;
StopSound :: fn (sound: Sound) #extern;
PauseSound :: fn (sound: Sound) #extern;
ResumeSound :: fn (sound: Sound) #extern;
IsSoundPlaying :: fn (sound: Sound) bool #extern;
SetSoundVolume :: fn (sound: Sound, volume: f32) #extern;
SetSoundPitch :: fn (sound: Sound, pitch: f32) #extern;
SetSoundPan :: fn (sound: Sound, pan: f32) #extern;

// Music streaming, playback, seeking, and controls.
LoadMusicStream :: fn (fileName: *s8) Music #extern;
LoadMusicStreamFromMemory :: fn (fileType: *s8, data: *u8, dataSize: s32) Music #extern;
IsMusicValid :: fn (music: Music) bool #extern;
UnloadMusicStream :: fn (music: Music) #extern;
PlayMusicStream :: fn (music: Music) #extern;
IsMusicStreamPlaying :: fn (music: Music) bool #extern;
UpdateMusicStream :: fn (music: Music) #extern;
StopMusicStream :: fn (music: Music) #extern;
PauseMusicStream :: fn (music: Music) #extern;
ResumeMusicStream :: fn (music: Music) #extern;
SeekMusicStream :: fn (music: Music, position: f32) #extern;
SetMusicVolume :: fn (music: Music, volume: f32) #extern;
SetMusicPitch :: fn (music: Music, pitch: f32) #extern;
SetMusicPan :: fn (music: Music, pan: f32) #extern;
GetMusicTimeLength :: fn (music: Music) f32 #extern;
GetMusicTimePlayed :: fn (music: Music) f32 #extern;

// Raw audio stream management and processing callbacks.
LoadAudioStream :: fn (sampleRate: u32, sampleSize: u32, channels: u32) AudioStream #extern;
IsAudioStreamValid :: fn (stream: AudioStream) bool #extern;
UnloadAudioStream :: fn (stream: AudioStream) #extern;
UpdateAudioStream :: fn (stream: AudioStream, data: *u8, frameCount: s32) #extern;
IsAudioStreamProcessed :: fn (stream: AudioStream) bool #extern;
PlayAudioStream :: fn (stream: AudioStream) #extern;
PauseAudioStream :: fn (stream: AudioStream) #extern;
ResumeAudioStream :: fn (stream: AudioStream) #extern;
IsAudioStreamPlaying :: fn (stream: AudioStream) bool #extern;
StopAudioStream :: fn (stream: AudioStream) #extern;
SetAudioStreamVolume :: fn (stream: AudioStream, volume: f32) #extern;
SetAudioStreamPitch :: fn (stream: AudioStream, pitch: f32) #extern;
SetAudioStreamPan :: fn (stream: AudioStream, pan: f32) #extern;
SetAudioStreamBufferSizeDefault :: fn (size: s32) #extern;
SetAudioStreamCallback :: fn (stream: AudioStream, callback: AudioCallback) #extern;
AttachAudioStreamProcessor :: fn (stream: AudioStream, processor: AudioCallback) #extern;
DetachAudioStreamProcessor :: fn (stream: AudioStream, processor: AudioCallback) #extern;
AttachAudioMixedProcessor :: fn (processor: AudioCallback) #extern;
DetachAudioMixedProcessor :: fn (processor: AudioCallback) #extern;

// Raylib log levels.
LOG_ALL :: 0;
LOG_TRACE :: 1;
LOG_DEBUG :: 2;
LOG_INFO :: 3;
LOG_WARNING :: 4;
LOG_ERROR :: 5;
LOG_FATAL :: 6;
LOG_NONE :: 7;
